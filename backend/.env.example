# =========================================================
# SPORTING - BACKEND ENVIRONMENT CONFIGURATION EXAMPLE
# File: backend/.env.example
# =========================================================

# ---------------------------------------------------------
# SERVER
# ---------------------------------------------------------

PORT=5000

NODE_ENV=development


# ---------------------------------------------------------
# MONGODB
# ---------------------------------------------------------
# Replace the example value with your MongoDB connection
# string when creating the real .env file.

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/SPORTING?retryWrites=true&w=majority


# ---------------------------------------------------------
# JWT AUTHENTICATION
# ---------------------------------------------------------
# Use a long random secret for production.

JWT_SECRET=replace_with_a_long_random_secret

JWT_EXPIRES_IN=7d


# ---------------------------------------------------------
# EMAIL / GMAIL SMTP
# ---------------------------------------------------------
# EMAIL_USER = Gmail address used by SPORTING to send mail.
#
# EMAIL_PASS should be a Gmail App Password, not your normal
# Gmail account password.

EMAIL_USER=your-gmail-address@gmail.com

EMAIL_PASS=your-gmail-app-password


# ---------------------------------------------------------
# SPORTING COMPANY EMAIL
# ---------------------------------------------------------

COMPANY_EMAIL=singhpratik0143@gmail.com


# ---------------------------------------------------------
# ADMIN ACCOUNT
# ---------------------------------------------------------
# Used only when running:
# node seeds/adminSeed.js
#
# IMPORTANT:
# Do not commit your real ADMIN_PASSWORD to GitHub.

ADMIN_NAME=SPORTING Admin

ADMIN_EMAIL=singhpratik0143@gmail.com

ADMIN_PASSWORD=replace_with_a_secure_admin_password


# ---------------------------------------------------------
# FRONTEND
# ---------------------------------------------------------
# Development:
# FRONTEND_URL=http://localhost:5500
#
# Production:
# Replace with your deployed frontend URL.

FRONTEND_URL=http://localhost:5500
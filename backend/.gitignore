# =========================================================
# SPORTING - BACKEND GITIGNORE
# File: backend/.gitignore
# =========================================================

# Node.js dependencies
node_modules/

# Environment variables
.env
.env.local
.env.development
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Build/output folders
dist/
build/

# Temporary files
tmp/
temp/
.cache/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/

# Windows files
*.lnk

# Debug files
*.stackdump

# Local database files
*.sqlite
*.sqlite3
*.db

# Environment backups
.env.*
!.env.example